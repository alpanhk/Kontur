# Opsional: Koneksi PostgreSQL eksternal (mis. postgresql://postgres:postgres@127.0.0.1:5432/app_db).
# Jika dikosongkan, aplikasi otomatis memakai PostgreSQL lokal terintegrasi (PGlite) di ./data/pglite.
DATABASE_URL=

# Opsional: Direktori penyimpanan PGlite jika DATABASE_URL tidak diisi (default: ./data/pglite)
# PGLITE_DATA_DIR=./data/pglite

# Opsional: Kunci Google Maps Elevation API
# GOOGLE_MAPS_API_KEY=

# Opsional: Perintah konverter eksternal DXF ke DWG (mis. ODA File Converter)
# DWG_CONVERTER_COMMAND=
